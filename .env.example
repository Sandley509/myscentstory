# ---------------------------------------------------------------------------
# MyScentStory — copy to `.env.local` and fill in.
# ---------------------------------------------------------------------------

# Default store name (also editable in /admin → Settings)
NEXT_PUBLIC_STORE_NAME="MyScentStory"

# Public URL of the live site, no trailing slash. IMPORTANT: canonical URLs,
# the sitemap, structured data and the Google / Meta product feeds are all
# built from this, so set it to the real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# "anon" / "publishable" key — safe in the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# "service_role" / "secret" key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe → Developers → API keys (sk_test_… while testing)
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=""

# Optional: secret for POST /api/revalidate?secret=…
REVALIDATION_SECRET=""

# --- Google & Meta (all optional; leave empty until you have the accounts) ---
# Search Console / Merchant Center → "HTML tag" verification → the content="" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Meta Business Settings → Brand safety → Domains → meta-tag verification value
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=""
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""
# Google Ads conversion ID (AW-XXXXXXXXXX) and the purchase conversion label
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""
# Meta Pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Order emails (confirmation + shipping updates) ---------------------------
# resend.com → API Keys. Verify your domain (myscentstory.net) in Resend first.
RESEND_API_KEY=""
# Sender shown to customers; must use the verified domain.
EMAIL_FROM="MyScentStory <orders@myscentstory.net>"
# Optional: secret for signed order-tracking links (defaults to the service key).
ORDER_LINK_SECRET=""
# Optional: exchange-rate source; {base} is replaced by the store currency.
# EXCHANGE_RATES_URL="https://open.er-api.com/v6/latest/{base}"

# --- Maintenance mode ---------------------------------------------------------
# "on" shows shoppers a "back soon" page (admin, Stripe and logged-in admins still work).
# On Vercel: change it in Settings → Environment Variables, then redeploy.
MAINTENANCE_MODE="off"

